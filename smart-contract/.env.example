# Contract tooling. Copy to `.env`; never commit real values.
# Sign with an encrypted keystore (`--account <name>`) rather than a raw key where possible.

# Deployer wallet (legacy Deploy.s.sol and the Phase 5 DeployClub / ImportLegacy scripts)
PRIVATE_KEY=
ALCHEMY_API_KEY=
BASESCAN_API_KEY=

# ── Legacy deploy (Deploy.s.sol) ─────────────────────────────────────────
RELAY_WALLET=0x0000000000000000000000000000000000000000
BASE_CID=

# ── Phase 5 bootstrap (see DEPLOY.md) ────────────────────────────────────
# Frozen legacy registry and the history export written by backend/scripts/legacy-export.ts
LEGACY_REGISTRY=0x7bEf8C32157C0A40A51b9bebeb7B36f236316192
LEGACY_DATA=data/legacy.json
# Founders' Safe. Cancel-only guardian; never a backend key.
GUARDIAN_SAFE=
# Founding officers, comma separated, at least two. RELAY_WALLET must not be one of them.
OFFICERS=
# Optional. Rep half-life in days. Default: 180 (provisional)
# HALF_LIFE_DAYS=180
# Local and test networks only: allow a guardian that is not a contract. Default: false
# ALLOW_EOA_GUARDIAN=false

# Printed by DeployClub; needed by ImportLegacy
CLUB_TIMELOCK=
CLUB_REP=
CLUB_REGISTRY=
CLUB_GOVERNOR=
# Optional. Accounts per import transaction. Default: sized from the session count
# IMPORT_BATCH_SIZE=
# Set to true only after checking the imported balances. IRREVERSIBLE.
# FINALIZE=false
