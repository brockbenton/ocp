# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ocp"

# Chain access: an Alchemy key, or any RPC endpoint in RPC_URL (which takes precedence)
ALCHEMY_API_KEY="your_alchemy_api_key"
# RPC_URL=""
CHAIN_ID="84532"

# Phase 5 contracts, as printed by DeployClub (see smart-contract/DEPLOY.md)
CONTRACT_ADDRESS="0x..."   # AttendanceRegistry2
REP_ADDRESS="0x..."        # ClubRep
GOVERNOR_ADDRESS="0x..."   # ClubGovernor
TIMELOCK_ADDRESS="0x..."   # ClubTimelock
# Block the contracts were deployed in; the indexer starts here
INDEXER_START_BLOCK="0"
# The frozen legacy registry. Needed once, if any session rows predate registry scoping.
LEGACY_REGISTRY_ADDRESS="0x7bEf8C32157C0A40A51b9bebeb7B36f236316192"

# Wallets (never commit actual values). Neither may be an officer.
RELAY_PRIVATE_KEY="0x..."      # RELAY_ROLE only: mints tokens and pays gas for votes and credit pages
QR_SIGNER_PRIVATE_KEY="0x..."  # Signs QR payloads. Must hold NO on-chain role; one per environment

# Privy
PRIVY_APP_ID="your_privy_app_id"
PRIVY_APP_SECRET="your_privy_app_secret"

# QR settings: how long one QR image is valid. 300000 (5 min) is the default and the
# maximum; larger or invalid values are replaced by it.
QR_TTL_MS="300000"

# Server
PORT="3001"
NODE_ENV="development"
# Required. Comma-separated frontend origins allowed to call the API (exact match,
# no wildcards), e.g. "https://app.example.com,http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# ── Optional ──────────────────────────────────────────────────────────────
# The server starts without these. Remove the leading "#" to set one.

# Public base URL of this API, used in art and badge URLs.
# Default: empty, which makes those URLs relative. Set it in production.
# PUBLIC_API_URL="https://api.example.com"

# Pinata JWT for pinning token metadata to IPFS.
# Default: unset, so "publish metadata" is a dry run and meetings get no per-session CID.
# PINATA_JWT=""

# Directory CID used to build token metadata URIs.
# Default: unset, so metadata URIs resolve to null.
# CONTRACT_BASE_CID=""

# Art CID for semesters with no entry in SEMESTER_ART_CIDS.
# Default: a placeholder CID that ends up in published metadata, so set it.
# DEFAULT_SEMESTER_ART_CID=""

# Per-semester art CIDs as a JSON object. Default: no per-semester art.
# Invalid JSON is logged and ignored.
# SEMESTER_ART_CIDS='{"Spring 2026":"bafy...","Fall 2026":"bafy..."}'

# Log a warning when the relay wallet holds less than this much ETH. Default: 0.005
# RELAY_MIN_BALANCE_ETH="0.005"
# Highest fee per gas the relay will offer, in gwei. Default: 5
# RELAY_MAX_FEE_GWEI="5"
# Replace an unmined relay transaction after this long. Default: 60000
# RELAY_STUCK_AFTER_MS="60000"
# How often the relay looks for work. Default: 3000
# RELAY_TICK_MS="3000"

# Blocks before a transaction or event is treated as final. Default: 5
# CONFIRMATIONS="5"
# How often the indexer polls, and how many blocks it requests at once (lower it if the
# RPC provider limits log ranges). Defaults: 5000 and 2000
# INDEXER_POLL_MS="5000"
# INDEXER_BLOCK_CHUNK="2000"

# Warn officers when a session has been open this many hours (never auto-closes). Default: 6
# OPEN_SESSION_WARN_HOURS="6"
# Slack- or Discord-compatible webhook for officer alerts. Default: unset (log and dashboard only)
# ALERT_WEBHOOK_URL=""
